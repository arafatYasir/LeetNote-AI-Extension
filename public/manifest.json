{
    "manifest_version": 3,
    "name": "LeetNote AI",
    "version": "1.0.0",
    "description": "Turn your LeetCode solutions into structured DSA notes with AI-powered insights, key algorithmic patterns, and concise approach explanations with just one click.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_popup": "index.html",
        "default_title": "LeetNote AI",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    },
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://leetcode.com/problems/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "host_permissions": [
        "https://generativelanguage.googleapis.com/*"
    ]
}